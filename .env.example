# Source environment (queries will be mapped FROM here)
SOURCE_URL=https://cxserver.example.com
SOURCE_USERNAME=admin
SOURCE_PASSWORD=example_password

# Target environment (queries will be mapped TO here)
TARGET_URL=https://cxserver2.example.com
TARGET_USERNAME=admin
TARGET_PASSWORD=example_password

# Optional: set to true to skip TLS certificate verification (not recommended for production)
VERIFY_SSL=false

# Optional: output file path (default: mapping.json)
OUTPUT_FILE=mapping.json
